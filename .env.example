# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA DataMall API Key (Singapore Land Transport Authority)
# Obtain your free key from https://datamall.lta.gov.sg/
LTA_DATAMALL_KEY="YOUR_LTA_DATAMALL_ACCOUNT_KEY"

# OpenFoodFacts User-Agent header
OPENFOODFACTS_USER_AGENT="YourApp/1.0 (your-app.vercel.app)"

# TheSportsDB API Key (Free tier uses '123' or custom V1/V2 key)
THESPORTSDB_API_KEY="123"

# Ticketmaster API Key (Optional for sporting event discovery)
TICKETMASTER_API_KEY="YOUR_TICKETMASTER_API_KEY"

